{
  "name": "bader-account-management",
  "version": "3.0.0",
  "description": "Bader Account Management desktop application",
  "author": "Baderinfo",
  "private": true,
  "main": "electron-main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "electron:dev": "concurrently \"npm run dev\" \"wait-on http://localhost:3000/ar && electron .\"",
    "dist": "npm run build && electron-builder --win --x64",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/vault.test.mts",
    "dist:dir": "npm run build && electron-builder --dir"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/crypto-js": "^4.2.2",
    "@types/html2canvas": "^0.5.35",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "clsx": "^2.1.1",
    "concurrently": "^10.0.5",
    "crypto-js": "^4.2.0",
    "date-fns": "^4.4.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.52.0",
    "next": "16.3.8",
    "next-intl": "^4.14.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wait-on": "^9.5.1",
    "xlsx": "^0.18.5",
    "zustand": "^5.0.15"
  },
  "build": {
    "appId": "com.baderinfo.accountmanagement",
    "productName": "Bader Account Management",
    "npmRebuild": false,
    "buildDependenciesFromSource": false,
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "electron-main.js",
      "electron-ai.js",
      "electron-preload.js",
      "bader-license/**/*",
      "out/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Bader Account Management"
    },
    "asar": true,
    "publish": null
  },
  "dependencies": {}
}