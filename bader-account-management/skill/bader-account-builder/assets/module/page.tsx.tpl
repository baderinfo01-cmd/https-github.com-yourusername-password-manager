"use client";

import { useMemo, useState } from "react";
import { useLocale, useTranslations } from "next-intl";
import { Copy, Edit, Plus, Printer, Search, Star, Trash2, X, __ICON__ } from "lucide-react";
import AppLayout from "@/components/layout/AppLayout";
import { useStore } from "@/store/useStore";
import type { __Type__ } from "@/types";
import { copyToClipboard } from "@/lib/utils";
import { formatDate } from "@/lib/printReport";
import { print__Type__ } from "@/lib/reports";

type Form = Partial<__Type__>;
const EMPTY: Form = __EMPTY__;

/**
 * Generated by scripts/add_module.py from the module template. Same shape as accounts/page.tsx:
 * search, favourites, add/edit dialog, copy for secret fields, delete confirmation, printable report.
 * Everything here is yours to edit; the store slice lives in src/store/useStore.ts (// @module-* markers).
 */
export default function __Type__Page() {
  const t = useTranslations("__kind__");
  const tp = useTranslations("print") as unknown as (k: string, v?: Record<string, string | number>) => string;
  const tc = useTranslations("common");
  const locale = useLocale();
  void formatDate;

  const items = useStore((s) => s.__kind__);
  const add = useStore((s) => s.add__Type__);
  const update = useStore((s) => s.update__Type__);
  const remove = useStore((s) => s.delete__Type__);
  const toggleFav = useStore((s) => s.toggleFavorite__Type__);

  const [search, setSearch] = useState("");
  const [onlyFav, setOnlyFav] = useState(false);
  const [editing, setEditing] = useState<Form | null>(null);
  const [toDelete, setToDelete] = useState<__Type__ | null>(null);
  const [copied, setCopied] = useState<string | null>(null);
  const [error, setError] = useState("");

  const rows = useMemo(() => {
    const q = search.trim().toLowerCase();
    return items
      .filter((r) => (!onlyFav || r.isFavorite) && (!q || __SEARCH__.some((v) => String(v ?? "").toLowerCase().includes(q))))
      .sort((a, b) => String(a.__TITLE__).localeCompare(String(b.__TITLE__)));
  }, [items, search, onlyFav]);

  const save = () => {
    if (!String(editing?.__TITLE__ ?? "").trim()) return setError(t("nameRequired"));
    const data = __SAVE__;
    if (editing?.id) update(editing.id, data);
    else add(data as never);
    setEditing(null);
    setError("");
  };
  const copy = async (id: string, value: string) => {
    if (await copyToClipboard(value)) {
      setCopied(id);
      setTimeout(() => setCopied(null), 1500);
    }
  };

  const input = "w-full px-3 py-2 rounded-lg border border-border bg-card text-fg";
  const th = "py-2 px-3 text-start font-medium text-xs text-muted";
  const td = "py-2 px-3 align-middle";

  return (
    <AppLayout>
      <div className="max-w-5xl mx-auto space-y-5">
        <div className="flex flex-wrap items-center justify-between gap-3">
          <div>
            <h1 className="text-3xl font-bold flex items-center gap-3"><__ICON__ className="w-8 h-8 text-primary" />{t("title")}</h1>
            <p className="text-muted mt-1">{t("subtitle", { count: items.length })}</p>
          </div>
          <div className="flex gap-2">
            <button onClick={() => print__Type__({ locale, tp, title: t("title") }, rows, t)} className="px-4 py-2 rounded-xl border border-border bg-card flex items-center gap-2 text-sm" aria-label={tc("print")}>
              <Printer className="w-4 h-4" />{tc("print")}
            </button>
            <button onClick={() => { setEditing({ ...EMPTY }); setError(""); }} className="btn-3d px-5 py-2 rounded-xl text-white bg-primary flex items-center gap-2">
              <Plus className="w-5 h-5" />{t("add")}
            </button>
          </div>
        </div>

        <div className="glass rounded-2xl p-4 flex flex-wrap gap-3 items-center">
          <div className="relative flex-1 min-w-[200px]">
            <Search className="absolute start-3 top-1/2 -translate-y-1/2 w-4 h-4 text-muted" />
            <input value={search} onChange={(e) => setSearch(e.target.value)} placeholder={tc("search")} aria-label={tc("search")} className={`${input} ps-9`} />
          </div>
          <button onClick={() => setOnlyFav(!onlyFav)} className={`px-4 py-1.5 rounded-full text-sm ${onlyFav ? "text-white bg-primary" : "border border-border bg-card text-muted"}`}>{tc("favorites")}</button>
        </div>

        {rows.length === 0 ? (
          <div className="glass rounded-2xl p-10 text-center text-muted">{items.length === 0 ? t("empty") : tc("noResults")}</div>
        ) : (
          <div className="glass rounded-2xl overflow-x-auto">
            <table className="w-full text-sm min-w-[560px]">
              <thead><tr><th className={th} />__TH__<th className={th} /></tr></thead>
              <tbody>
                {rows.map((r) => (
                  <tr key={r.id} className="border-t border-border">
                    <td className={td}><button onClick={() => toggleFav(r.id)} aria-label={tc("favorite")}><Star className={`w-4 h-4 ${r.isFavorite ? "fill-yellow-400 text-yellow-500" : "text-muted"}`} /></button></td>
__TD__
                    <td className={`${td} whitespace-nowrap text-end`}>
                      <button onClick={() => { setEditing(r); setError(""); }} className="p-2 rounded-lg hover:bg-accent" aria-label={tc("edit")}><Edit className="w-4 h-4" /></button>
                      <button onClick={() => setToDelete(r)} className="p-2 rounded-lg hover:bg-red-500/10 text-red-600" aria-label={tc("delete")}><Trash2 className="w-4 h-4" /></button>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}
      </div>

      {editing && (
        <div className="fixed inset-0 z-50 flex items-center justify-center bg-black/40 p-4" role="dialog" aria-modal="true">
          <div className="bg-card text-fg border border-border rounded-2xl p-6 w-full max-w-lg space-y-3 max-h-[90vh] overflow-y-auto">
            <div className="flex items-center justify-between">
              <h3 className="text-lg font-bold">{editing.id ? t("edit") : t("add")}</h3>
              <button onClick={() => setEditing(null)} aria-label={tc("cancel")} className="p-1.5 rounded-lg hover:bg-accent"><X className="w-5 h-5" /></button>
            </div>
__FORM__
            {error && <p role="alert" className="text-sm text-red-600">{error}</p>}
            <div className="flex justify-end gap-2 pt-1">
              <button onClick={() => setEditing(null)} className="px-4 py-2 rounded-lg bg-accent">{tc("cancel")}</button>
              <button onClick={save} className="px-5 py-2 rounded-lg text-white bg-primary">{tc("save")}</button>
            </div>
          </div>
        </div>
      )}

      {toDelete && (
        <div className="fixed inset-0 z-50 flex items-center justify-center bg-black/40 p-4" role="alertdialog" aria-modal="true">
          <div className="bg-card text-fg border border-border rounded-2xl p-6 w-full max-w-sm space-y-4">
            <p>{t("confirmDelete", { name: String(toDelete.__TITLE__) })}</p>
            <div className="flex justify-end gap-2">
              <button onClick={() => setToDelete(null)} className="px-4 py-2 rounded-lg bg-accent">{tc("cancel")}</button>
              <button onClick={() => { remove(toDelete.id); setToDelete(null); }} className="px-4 py-2 rounded-lg text-white bg-red-600">{tc("delete")}</button>
            </div>
          </div>
        </div>
      )}
    </AppLayout>
  );
}
