{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 2,
  "settings": {
    "appearanceTools": true,
    "layout": { "contentSize": "760px", "wideSize": "1120px" },
    "useRootPaddingAwareAlignments": true,
    "color": {
      "defaultPalette": false,
      "defaultGradients": false,
      "custom": true,
      "customGradient": true,
      "palette": [
        { "slug": "accent", "color": "#2F5BFF", "name": "Accent" },
        { "slug": "accent-2", "color": "#22C3F0", "name": "Accent 2" },
        { "slug": "accent-dark", "color": "#1E40C8", "name": "Accent dark" },
        { "slug": "ink", "color": "#0B1220", "name": "Ink" },
        { "slug": "body", "color": "#39465C", "name": "Body" },
        { "slug": "muted", "color": "#6B7A92", "name": "Muted" },
        { "slug": "bg", "color": "#FFFFFF", "name": "Background" },
        { "slug": "bg-2", "color": "#F6F8FD", "name": "Background soft" },
        { "slug": "soft", "color": "#EEF2FB", "name": "Soft" },
        { "slug": "line", "color": "#E6EBF5", "name": "Line" },
        { "slug": "white", "color": "#FFFFFF", "name": "White" }
      ],
      "gradients": [
        { "slug": "brand", "gradient": "linear-gradient(135deg,#22C3F0 0%,#2F5BFF 58%,#1E40C8 100%)", "name": "Brand" },
        { "slug": "brand-soft", "gradient": "linear-gradient(135deg,rgba(34,195,240,0.12),rgba(47,91,255,0.10))", "name": "Brand soft" }
      ]
    },
    "typography": {
      "fluid": true,
      "customFontSize": true,
      "lineHeight": true,
      "dropCap": false,
      "fontFamilies": [
        { "slug": "sans", "name": "Sans", "fontFamily": "'El Messiri', system-ui, sans-serif" },
        { "slug": "head", "name": "Heading", "fontFamily": "'El Messiri', system-ui, sans-serif" },
        { "slug": "arabic", "name": "Arabic", "fontFamily": "'El Messiri', system-ui, sans-serif" },
        { "slug": "mono", "name": "Mono", "fontFamily": "'JetBrains Mono', ui-monospace, monospace" }
      ],
      "fontSizes": [
        { "slug": "small", "size": "0.9rem", "name": "Small" },
        { "slug": "medium", "size": "1.05rem", "name": "Medium", "fluid": { "min": "1rem", "max": "1.15rem" } },
        { "slug": "large", "size": "1.5rem", "name": "Large", "fluid": { "min": "1.3rem", "max": "1.75rem" } },
        { "slug": "x-large", "size": "2.2rem", "name": "X-Large", "fluid": { "min": "1.8rem", "max": "2.6rem" } },
        { "slug": "xx-large", "size": "3.4rem", "name": "Display", "fluid": { "min": "2.3rem", "max": "3.9rem" } }
      ]
    },
    "spacing": {
      "units": [ "px", "em", "rem", "vw", "%" ],
      "customSpacingSize": true,
      "spacingScale": { "steps": 8 }
    },
    "border": { "color": true, "radius": true, "style": true, "width": true },
    "shadow": {
      "defaultPresets": false,
      "presets": [
        { "slug": "soft", "name": "Soft", "shadow": "0 14px 36px -18px rgba(11,18,32,0.20)" },
        { "slug": "large", "name": "Large", "shadow": "0 34px 70px -28px rgba(11,18,32,0.32)" }
      ]
    }
  },
  "styles": {
    "color": { "background": "var(--wp--preset--color--bg)", "text": "var(--wp--preset--color--body)" },
    "typography": { "fontFamily": "var(--wp--preset--font-family--sans)", "fontSize": "var(--wp--preset--font-size--medium)", "lineHeight": "1.75" },
    "spacing": { "blockGap": "1.4rem", "padding": { "left": "clamp(16px,4vw,28px)", "right": "clamp(16px,4vw,28px)" } },
    "elements": {
      "heading": { "typography": { "fontFamily": "var(--wp--preset--font-family--head)", "fontWeight": "700", "lineHeight": "1.18" }, "color": { "text": "var(--wp--preset--color--ink)" } },
      "h1": { "typography": { "fontSize": "var(--wp--preset--font-size--xx-large)" } },
      "h2": { "typography": { "fontSize": "var(--wp--preset--font-size--x-large)" } },
      "link": { "color": { "text": "var(--wp--preset--color--accent)" }, ":hover": { "color": { "text": "var(--wp--preset--color--accent-dark)" } } },
      "button": {
        "border": { "radius": "13px" },
        "color": { "background": "var(--wp--preset--color--accent)", "text": "#ffffff" },
        "typography": { "fontFamily": "var(--wp--preset--font-family--head)", "fontWeight": "600" },
        "spacing": { "padding": { "top": "0.85em", "bottom": "0.85em", "left": "1.6em", "right": "1.6em" } },
        ":hover": { "color": { "background": "var(--wp--preset--color--accent-dark)" } }
      }
    }
  },
  "customTemplates": [
    { "name": "page-landing", "title": "Landing (full width)", "postTypes": [ "page" ] }
  ],
  "templateParts": [
    { "name": "header", "title": "Header", "area": "header" },
    { "name": "footer", "title": "Footer", "area": "footer" }
  ]
}
